datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Brand {
  id        String   @id @default(cuid())
  shop      String
  name      String
  logoUrl   String?
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts          Post[]
  socialAccounts BrandSocialAccount[]

  @@index([shop])
}

// A social media account connected at the shop level. One physical account
// (e.g. a Facebook page or Bluesky handle) is stored once per shop and can be
// shared across brands via BrandSocialAccount. Token columns are encrypted at
// rest by crypto.server; the same encrypted strings can be reused across brands.
model SocialAccount {
  id           String    @id @default(cuid())
  shop         String
  platform     String
  accountId    String
  accountName  String?
  accessToken  String
  refreshToken String?
  tokenSecret  String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  brandLinks    BrandSocialAccount[]
  platformPosts PostPlatform[]

  @@unique([shop, platform, accountId])
  @@index([shop])
}

// Join table letting multiple brands share a single shop-level SocialAccount
// (e.g. a parent-company page that also appears on a child brand).
model BrandSocialAccount {
  id              String @id @default(cuid())
  brandId         String
  socialAccountId String

  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([brandId, socialAccountId])
  @@index([brandId])
  @@index([socialAccountId])
}

model Post {
  id          String    @id @default(cuid())
  shop        String
  brandId     String
  postType    String
  status      String    @default("draft")
  scheduledAt DateTime?
  publishedAt DateTime?
  bullJobId   String?
  mainContent String

  // Optional linked Shopify product. Products live in Shopify, so these are
  // plain nullable columns with no relation. When a specific variant is linked,
  // productUrl carries ?variant=<numeric id> so the storefront preselects it.
  productId     String?
  productHandle String?
  productTitle  String?
  productUrl    String?
  variantId     String?
  variantTitle  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand         Brand          @relation(fields: [brandId], references: [id])
  platformPosts PostPlatform[]
  mediaAssets   MediaAsset[]

  @@index([shop])
  @@index([brandId])
  @@index([scheduledAt])
  @@index([status])
}

model PostPlatform {
  id              String    @id @default(cuid())
  postId          String
  platform        String
  // Null for manual platforms (e.g. rednote) which have no connected account.
  // A post may target two accounts on the SAME platform (two Facebook pages),
  // so rows are keyed by socialAccountId rather than platform.
  socialAccountId String?
  content         String?
  extraJson       String?
  status          String    @default("pending")
  platformPostId  String?
  errorMessage    String?
  bullJobId       String?
  publishAt       DateTime?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  // Postgres treats NULLs as distinct, so multiple manual rows (null account)
  // are allowed by the DB; the service layer enforces at most one manual row
  // per platform per post.
  @@unique([postId, socialAccountId])
  @@index([postId])
  @@index([socialAccountId])
}

model ShopSettings {
  id             String   @id @default(cuid())
  shop           String   @unique
  holidayCountry String   @default("US")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MediaAsset {
  id          String   @id @default(cuid())
  postId      String
  url         String
  mimeType    String
  width       Int?
  height      Int?
  durationSec Float?
  sizeBytes   Int?
  altText     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model ProductHashtag {
  id         String   @id @default(cuid())
  shop       String
  productId  String
  hashtag    String
  usageCount Int      @default(1)
  lastUsedAt DateTime @updatedAt

  @@unique([shop, productId, hashtag])
  @@index([shop, productId])
}

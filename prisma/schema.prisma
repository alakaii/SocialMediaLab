datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Brand {
  id        String   @id @default(cuid())
  shop      String
  name      String
  logoUrl   String?
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts          Post[]
  socialAccounts BrandSocialAccount[]

  @@index([shop])
}

// A social media account connected at the shop level. One physical account
// (e.g. a Facebook page or Bluesky handle) is stored once per shop and can be
// shared across brands via BrandSocialAccount. Token columns are encrypted at
// rest by crypto.server; the same encrypted strings can be reused across brands.
model SocialAccount {
  id           String    @id @default(cuid())
  shop         String
  platform     String
  accountId    String
  accountName  String?
  accessToken  String
  refreshToken String?
  tokenSecret  String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  brandLinks    BrandSocialAccount[]
  platformPosts PostPlatform[]

  @@unique([shop, platform, accountId])
  @@index([shop])
}

// Join table letting multiple brands share a single shop-level SocialAccount
// (e.g. a parent-company page that also appears on a child brand).
model BrandSocialAccount {
  id              String @id @default(cuid())
  brandId         String
  socialAccountId String

  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([brandId, socialAccountId])
  @@index([brandId])
  @@index([socialAccountId])
}

model Post {
  id          String    @id @default(cuid())
  shop        String
  brandId     String
  postType    String
  status      String    @default("draft")
  scheduledAt DateTime?
  publishedAt DateTime?
  bullJobId   String?
  mainContent String

  // Optional linked Shopify product. Products live in Shopify, so these are
  // plain nullable columns with no relation. When a specific variant is linked,
  // productUrl carries ?variant=<numeric id> so the storefront preselects it.
  productId     String?
  productHandle String?
  productTitle  String?
  productUrl    String?
  variantId     String?
  variantTitle  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand         Brand          @relation(fields: [brandId], references: [id])
  platformPosts PostPlatform[]
  mediaAssets   MediaAsset[]

  @@index([shop])
  @@index([brandId])
  @@index([scheduledAt])
  @@index([status])
}

model PostPlatform {
  id              String    @id @default(cuid())
  postId          String
  platform        String
  // Null for manual platforms (e.g. rednote) which have no connected account.
  // A post may target two accounts on the SAME platform (two Facebook pages),
  // so rows are keyed by socialAccountId rather than platform.
  socialAccountId String?
  content         String?
  extraJson       String?
  status          String    @default("pending")
  platformPostId  String?
  errorMessage    String?
  bullJobId       String?
  publishAt       DateTime?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  // Postgres treats NULLs as distinct, so multiple manual rows (null account)
  // are allowed by the DB; the service layer enforces at most one manual row
  // per platform per post.
  @@unique([postId, socialAccountId])
  @@index([postId])
  @@index([socialAccountId])
}

model ShopSettings {
  id                    String    @id @default(cuid())
  shop                  String    @unique
  holidayCountry        String    @default("US")
  // Set once the merchant dismisses the home page setup guide. Null means the
  // guide is still showing.
  onboardingDismissedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// Cached subscription state for one shop, under Shopify App Pricing.
//
// App Pricing sends no webhooks, so subscription state is read back from the
// Partner API (which identifies shops by GID, not domain) on page load and
// cached here. The cache is also the safety net: a failed or unconfigured
// Partner read must never downgrade a paying merchant, so the last known good
// tier survives an outage.
model ShopBilling {
  id         String    @id @default(cuid())
  shop       String    @unique
  /// gid://shopify/Shop/... captured after auth. Required by the Partner API.
  shopGid    String?
  /// The plan's internal handle (not its display name), as reported by the API.
  planHandle String?
  /// Feature tier granted to this shop. "none" locks the app behind the plan page.
  tier       String    @default("none")
  /// Which system granted the tier: "app_pricing" | "legacy" | "none".
  tierSource String    @default("none")
  /// When the Partner API was last consulted, successful or not.
  lastSyncAt DateTime?
  /// False when the last read failed, so a stale tier can be spotted in support.
  lastSyncOk Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Maps a plan's internal handle to a feature tier. The Partner Dashboard can
// grow plans this code has never heard of (private plans, promo plans), and a
// mapping row beats shipping a release, so this table is the override point.
model PlanTierMapping {
  id         String   @id @default(cuid())
  planHandle String   @unique
  tier       String
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Singleton-ish banner rendered at the top of every merchant's admin, edited
// from the owner-only surface. Exists so an outage notice does not need a
// deploy.
model GlobalBanner {
  id        String   @id @default(cuid())
  message   String
  /// Polaris banner tone: "info" | "warning" | "critical" | "success".
  tone      String   @default("info")
  active    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id          String   @id @default(cuid())
  postId      String
  url         String
  mimeType    String
  width       Int?
  height      Int?
  durationSec Float?
  sizeBytes   Int?
  altText     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model ProductHashtag {
  id         String   @id @default(cuid())
  shop       String
  productId  String
  hashtag    String
  usageCount Int      @default(1)
  lastUsedAt DateTime @updatedAt

  @@unique([shop, productId, hashtag])
  @@index([shop, productId])
}

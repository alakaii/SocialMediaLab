DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_media_lab"
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SCOPES="read_files,write_files,read_products,read_content"
# Public https URL of the app (used by Shopify auth). HOST stays the bind
# address for remix-serve (e.g. 0.0.0.0 in production); don't conflate them.
SHOPIFY_APP_URL=""
REDIS_URL="redis://localhost:6379"

# --- Shopify App Pricing / Partner API -------------------------------------
# The app sells through Shopify App Pricing (the Billing API replacement), so
# plans live in the Partner Dashboard and subscription state is read back from
# the Partner API. None of these are secrets Shopify sends us; they are copied
# in by hand once and then never change.

# The app handle, used to build the hosted plan page URL
# (https://admin.shopify.com/store/{store}/charges/{SHOPIFY_APP_HANDLE}/pricing_plans).
# This is NOT the App Store listing slug; the two can differ. Verify it with the
# Admin API: currentAppInstallation { app { handle } }. Unset makes the plan page
# throw rather than render a broken link.
SHOPIFY_APP_HANDLE=""

# The app's global id (gid://shopify/App/...). Partner Dashboard app URL contains
# the numeric id, or read it from the Admin API: currentAppInstallation { app { id } }.
SHOPIFY_APP_GID=""

# Partner API access token. Partner Dashboard > Settings > Partner API clients
# (only the org owner can create one). Needs the "Manage apps" permission. Unlike
# Admin tokens this one does not expire, so it is the reliable server-side
# credential. Leave empty to disable the Partner read (tiers then never change).
SHOPIFY_PARTNER_API_TOKEN=""

# Partner organization id: the number in the Partner Dashboard URL
# (https://partners.shopify.com/{SHOPIFY_PARTNER_ORG_ID}/...).
SHOPIFY_PARTNER_ORG_ID=""

# --- Usage-based billing (App Events) --------------------------------------
# The plan is $0 base, free to install, and charges $2 per brand per month
# through a usage meter. The app's whole side of that is one App Event per shop
# per calendar month carrying the brand count; Shopify multiplies and invoices.
#
# The dashboard side has to exist first, and this code cannot create it:
#   1. On the public plan, add a usage meter.
#   2. Give the meter an event handle (this app defaults to "brands") and set
#      SHOPIFY_USAGE_EVENT_HANDLE below if you pick a different one.
#   3. Set the meter's pricing structure to a flat rate of $2.00 per unit.
# An event whose handle matches no meter is accepted (the API always answers
# 202) and silently dropped, so a typo here bills nothing and reports nothing.

# Master switch. Anything but exactly "true" runs the sweep in dry-run: it still
# counts brands and writes a ledger row (status "dry_run"), but sends nothing.
# Ships off, so this code can deploy before the meter exists. Turn it on only
# once the meter is live, and check the owner surface's "Usage emissions" card
# afterwards: App Events have no read-back, so that ledger is the only record.
USAGE_BILLING_ENABLED="false"

# The meter's event handle from the dashboard. Defaults to "brands" in code.
SHOPIFY_USAGE_EVENT_HANDLE=""

# Credentials for the App Events client-credentials grant
# (POST https://api.shopify.com/auth/access_token). Shopify's docs describe an
# API key created in the Dev Dashboard, which is a separate credential from the
# app's own client id and secret. Leave these empty to fall back to
# SHOPIFY_API_KEY and SHOPIFY_API_SECRET above.
SHOPIFY_APP_EVENTS_CLIENT_ID=""
SHOPIFY_APP_EVENTS_CLIENT_SECRET=""

# Full .myshopify.com domain of the store allowed into the owner-only surface
# (plan handle mappings, global banner). Unset means nobody, never everybody.
APP_OWNER_SHOP=""

# 32-byte base64 key used to encrypt social OAuth tokens at rest (AES-256-GCM).
# Required in production. Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=""

# Twitter / X
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# Meta (Instagram + Facebook)
META_APP_ID=""
META_APP_SECRET=""

# TikTok
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Google (YouTube)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# RedNote
REDNOTE_API_KEY=""

# Dropbox (the "From cloud" media tab). Create an app in the Dropbox App Console
# (https://www.dropbox.com/developers/apps) and copy its App key here. Under that
# app's Settings > Chooser/Saver/Embedder domains, add the app's domain (the host
# of SHOPIFY_APP_URL, plus localhost for local development) or the file picker
# will refuse to open. Only the public App key is needed; there is no secret and
# no OAuth flow, because the picker runs in the merchant's browser. Leave it
# empty to hide Dropbox behind a "not configured" message.
DROPBOX_APP_KEY=""

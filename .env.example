DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_media_lab"
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SCOPES="read_files,write_files,read_products"
# Public https URL of the app (used by Shopify auth). HOST stays the bind
# address for remix-serve (e.g. 0.0.0.0 in production); don't conflate them.
SHOPIFY_APP_URL=""
REDIS_URL="redis://localhost:6379"

# 32-byte base64 key used to encrypt social OAuth tokens at rest (AES-256-GCM).
# Required in production. Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=""

# Twitter / X
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# Meta (Instagram + Facebook)
META_APP_ID=""
META_APP_SECRET=""

# TikTok
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Google (YouTube)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# RedNote
REDNOTE_API_KEY=""

# Dropbox (the "From cloud" media tab). Create an app in the Dropbox App Console
# (https://www.dropbox.com/developers/apps) and copy its App key here. Under that
# app's Settings > Chooser/Saver/Embedder domains, add the app's domain (the host
# of SHOPIFY_APP_URL, plus localhost for local development) or the file picker
# will refuse to open. Only the public App key is needed; there is no secret and
# no OAuth flow, because the picker runs in the merchant's browser. Leave it
# empty to hide Dropbox behind a "not configured" message.
DROPBOX_APP_KEY=""
